<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="12dp">

            <!-- 顶部标题区：头像（左）+ 居中标题 + 菜单（右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="关于"
                        android:focusable="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar"
                        app:shapeAppearanceOverlay="@style/CircleImage" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ATrace"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ImGui Overlay 调试器"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageButton
                        android:id="@+id/btn_more"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="更多"
                        android:src="@drawable/ic_more_vert"
                        android:tint="#FFC9CDD2" />
                </FrameLayout>
            </LinearLayout>

            <!-- 服务状态卡片 -->
            <com.Alive.Trace.ui.StatusCard
                android:id="@+id/status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <!-- 目标进程卡片 -->
            <com.Alive.Trace.ui.ProcessCard
                android:id="@+id/process_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap" />

            <!-- 权限状态卡片 -->
            <com.Alive.Trace.ui.PermissionCard
                android:id="@+id/permission_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap" />

            <!-- 关于卡片 -->
            <com.Alive.Trace.ui.AboutCard
                android:id="@+id/about_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部固定：启动按钮 + 提示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/btn_launch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/launch_btn_height"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:drawableStart="@drawable/ic_play_arrow"
            android:drawablePadding="12dp"
            android:drawableTint="@color/btn_text_dark"
            android:focusable="true"
            android:gravity="center"
            android:text="启动 Overlay"
            android:textColor="@color/btn_text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="启动后，ImGui 调试界面将显示在所有应用上层"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
